{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=./data/audios.db"
  },
  "Storage": {
    "LocalPath": "./filestore"
  },
  "Upload": {
    "MaxSizeBytes": 52428800,
    "AllowedExtensions": [ ".mp3", ".wav", ".ogg", ".flac", ".m4a", ".aac", ".webm" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Compression": {
    "FfmpegPath": "ffmpeg",
    "BitrateKbps": 128
  },
  "Summarization": {
    "Enabled": false,
    "Endpoint": "http://localhost:9000",
    "ApiKey": "",
    "TimeoutSeconds": 300,
    "MaxSummaryChars": 500,
    "MaxConcurrency": 1,
    "QueueCapacity": 100
  }
}
